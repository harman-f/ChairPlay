@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Apply P8 (panel remove/re-add) onto a checkout that ALREADY has the panel-poc PanelUpdateProbe.kt.
+
+Fail-closed: unique-anchor edits, no partial writes. Default behaviour is unchanged (needs CHAIRPLAY_P8=1).
+Does NOT wire a UI/HTTP route: p8* modes arrive via the existing panelProbe(mode, value) path
+(POST panel-probe route of the panel-poc patch). Never run against a device without owner approval.
+"""
+import sys
+from pathlib import Path
+
+if len(sys.argv) != 2:
+    raise SystemExit('usage: apply_p8.py <checkout>')
+root = Path(sys.argv[1]).resolve()
+here = Path(__file__).resolve().parent
+src = root / 'src/main/kotlin/io/github/numberonebot/chairplay'
+probe = src / 'PanelUpdateProbe.kt'
+target = src / 'PanelReaddProbe.kt'
+text = probe.read_text(encoding='utf-8')
+
+
+def sub(t, before, after):
+    if t.count(before) != 1:
+        raise RuntimeError(f'P8_ANCHOR_DRIFT {before[:70]!r} count={t.count(before)}')
+    return t.replace(before, after)
+
+
+text = sub(text, '    private var cluster: Map<String, Any?>? = null\n',
+           '    private var cluster: Map<String, Any?>? = null\n'
+           '    @Volatile private var allPanels: List<Map<String, Any?>>? = null\n')
+text = sub(text, '            cluster = target\n',
+           '            cluster = target\n            allPanels = panels.toList()\n')
+text = sub(text, '        if (mode == "status") return status()\n',
+           '        if (mode == "status") return status()\n'
+           '        if (mode.startsWith("p8")) return PanelReaddProbe.perform(mode, allPanels, active, sender, log)\n')
+if target.exists():
+    raise RuntimeError('P8_TARGET_EXISTS')
+target.write_text((here / 'PanelReaddProbe.kt').read_text(encoding='utf-8'), encoding='utf-8', newline='\n')
+probe.write_text(text, encoding='utf-8', newline='\n')
+print('P8_PATCH_APPLIED (default OFF: CHAIRPLAY_P8=1 + PanelUpdateProbe enabled + explicit p8* trigger)')
